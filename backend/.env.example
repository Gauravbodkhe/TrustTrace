# TrustTrace Backend Environment Variables

# Application
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=change-me-in-production-use-long-random-string
LOG_LEVEL=INFO

# Database (SQLite for local dev, Postgres for production)
DATABASE_URL=sqlite+aiosqlite:///./trusttrace.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trusttrace

# Supabase (optional, leave blank for local SQLite mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # Never expose this to frontend

# Google Gemini (optional — mock agent works without this)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CORS
FRONTEND_URL=http://localhost:5173

# Experiment Runner
MAX_CONCURRENT_RUNS=4
DEFAULT_MAX_RETRIES=3
DEFAULT_TIMEOUT_SECONDS=30
DEFAULT_REPETITIONS=3
