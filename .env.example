# ==============================================================================
# TrustTrace Configuration
# ==============================================================================

# Application Environment (development | production | test)
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=dev-secret-key-change-in-production

# Database
# Default: Zero-dependency local SQLite with WAL mode
DATABASE_URL=sqlite+aiosqlite:///./trusttrace.db
# Production Supabase PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres

# Google Gemini API Key (Optional)
# If left blank, TrustTrace functions seamlessly using the deterministic MockAgent
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend URL (For Backend CORS)
FRONTEND_URL=http://localhost:5173

# Experiment Execution Defaults
MAX_CONCURRENT_RUNS=4
DEFAULT_MAX_RETRIES=3
DEFAULT_TIMEOUT_SECONDS=30
DEFAULT_REPETITIONS=1
